# Variables para levantar TesisTrack en un servidor con docker compose.
# Copiar como .env (que está en .gitignore) y completar. Sin .env, el compose usa
# valores de desarrollo que están publicados en GitHub: sirven solo en local.

# Firma de los tokens de sesión. Obligatoria, mínimo 32 caracteres, distinta en
# cada servidor. Para generar una:  openssl rand -base64 48
JWT_SECRET=

# Clave del usuario de PostgreSQL (la usan la base y el backend). PostgreSQL la
# fija al crear el volumen: cambiarla después exige cambiarla también en la base.
DB_PASSWORD=

# La dirección pública del frontend, la que escribe la gente en el navegador.
CORS_ALLOWED_ORIGINS=https://tesistrack.example.com
